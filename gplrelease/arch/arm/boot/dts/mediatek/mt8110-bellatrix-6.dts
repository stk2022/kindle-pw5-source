/dts-v1/;
#include "mt8110-bellatrix.dtsi"

/ {
	model = "MT8110 Bellatrix platform board for 6";
};

&i2c0 {
	goodix_ts@14 {
		vdd_ana-supply = <&bd71828_ldo_avcc_touch>;
		vcc_i2c-supply = <&bd71828_ldo_dvcc_touch>;
		compatible = "goodix,gt9xx-ts";
		pinctrl-names = "default";
		pinctrl-0 = <&goodix_ts_pins_default>;
		reg = <0x14>;
		goodix,rst-gpio = <&pio 0 0>;
		goodix,irq-gpio = <&pio 1 0>;
	};

	fitipmic: fiti@18 {
		compatible = "fiti,pmic";
		reg = <0x18>;
		vgh_ext = <0>;
		vgl_ext = <2000>;
		xon_len = <2510>;
		xon_delay = <40>;
		vgh = <25000>;
		vgl = <20000>;
		vcom_setting = <2510>;
		vghnm_setting = <3300>;
		vghnm_ext = <1500>;
		vpos = <15000>;
		vneg = <15000>;
		epd-pmic-en = <&bd71828 1 0>;
		epd-pmic-op = <&pio 9 0>;
		epd-pmic-nm = <&pio 8 0>;
		interrupt-parent = <&pio>;
		interrupts = <10 IRQ_TYPE_LEVEL_HIGH>;
		deb-gpios = <&pio 5 0>;
		debounce = <16>;
		epd-supply = <&bd71828_ldo_dvcc_epd>;
		pinctrl-names = "active", "inactive";
		pinctrl-0 = <&fiti_pins_active>;
		pinctrl-1 = <&fiti_pins_inactive>;
		status = "okay";
	};
};

&i2c2 {
	opt3006@44 {
		compatible = "ti,opt3006";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&opt3006_pins_default>;
		pinctrl-1 = <&opt3006_pins_default>;
		reg = <0x44>;
		interrupt-parent = <&pio>;
		interrupts = <100 IRQ_TYPE_EDGE_FALLING>;
	};

	p922x@61 {
		compatible = "IDT,idt_wireless_power";
		reg = <0x61>;
		interrupt-parent = <&pio>;
		interrupts = <34 IRQ_TYPE_EDGE_FALLING 35 IRQ_TYPE_EDGE_RISING>;

		wpc-mivr = <4500000 4500000>;
		wpc-switch-voltage = <4500 5000 5500 8500 9000 9500>;
		bpp-5w-fod = /bits/ 8 <151 47 148 33 149 23 148 21
					148 21 149 21 254 127 0 0>;
		bpp-10w-fod = /bits/ 8 <254 127 254 127 254 127 254 127
					254 127 254 127 254 127 0 0>;

		pinctrl-names = "wpc_en_default", "wpc_en0", "wpc_en1",
					"sleep_en_default", "sleep_en0", "sleep_en1";
		pinctrl-0 = <&wpc_en_default>;
		pinctrl-1 = <&wpc_en0>;
		pinctrl-2 = <&wpc_en1>;
		pinctrl-3 = <&sleep_en_default>;
		pinctrl-4 = <&sleep_en0>;
		pinctrl-5 = <&sleep_en1>;

		p922x-irq = <&pio 34 0>;
		p922x-pg = <&pio 35 0>;

		wpc-hardware-config = <1>;
		status = "okay";
	};

	max20342: max20342@35 {
		compatible = "maxim,max20342";
		interrupt-parent = <&pio>;
		interrupt-controller;
		pinctrl-names = "default";
		pinctrl-0 = <&max20342_chg_det_pins_default>;
		chg_det_int = <&pio 29 GPIO_ACTIVE_LOW>;
		chg_det_ceb = <&pio 31 GPIO_ACTIVE_LOW>;
		reg = <0x35>;
		status = "okay";
	};
};

&hwtcon {
	status = "okay";
	pinctrl-names = "active","inactive";
	pinctrl-0 = <&hwtcon_pins_active>;
	pinctrl-1 = <&hwtcon_pins_inactive>;
	epd{
		panel_dpi_clk = <80000000>;
		panel_width = <1448>;
		panel_height = <1072>;
		panel_area_w = <122>;
		panel_area_h = <91>;
		panel_waveform_type = <4>;
		panel_output_8bit = <1>;
		panel_tcon0 = <6 1078 68 77 0 1 0 0>;
		panel_tcon1 = <6 1078 7 43 0 0 0 0>;
		panel_tcon2 = <6 1080 7 7 4 0 1 7>;
		panel_tcon3 = <1 1081 211 787 0 0 0 0>;
		panel_tcon4 = <0 0 0 0 0 0 0 0>;
		panel_tcon5 = <2 3 512 592 4 1 1 7>;
		panel_dpi = <18 40 12 2 11 4 0>;
		panel_material_type = <4>;
		panel_rotate = <3>;
		modify_wf_mode_counter = <1024>;
		status = "okay";
	};
};

&hwtcon_v2 {
	status = "okay";
	pinctrl-names = "active","inactive";
	pinctrl-0 = <&hwtcon_pins_active>;
	pinctrl-1 = <&hwtcon_pins_inactive>;
	epd{
		panel_dpi_clk = <80000000>;
		panel_width = <1448>;
		panel_height = <1072>;
		panel_area_w = <122>;
		panel_area_h = <91>;
		panel_waveform_type = <4>;
		panel_output_8bit = <1>;
		panel_tcon0 = <6 1078 68 77 0 1 0 0>;
		panel_tcon1 = <6 1078 7 43 0 0 0 0>;
		panel_tcon2 = <6 1080 7 7 4 0 1 7>;
		panel_tcon3 = <1 1081 211 787 0 0 0 0>;
		panel_tcon4 = <1 2 7 7 4 1 1 7>;
		panel_tcon5 = <2 3 512 592 4 1 1 7>;
		panel_dpi = <18 40 12 2 11 4 0>;
		panel_material_type = <4>;
		panel_rotate = <3>;
		modify_wf_mode_counter = <1024>;
		status = "okay";
	};
};

&pio {
	pinctrl-0 = <&unused_pins_default>;

	opt3006_pins_default: opt3006_default {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_100_DMIC0_DAT0__FUNC_GPIO100>;
			input-enable;
			bias-disable;
		};
	};

	goodix_ts_pins_default: goodix_ts_pins_default {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_26_USB_ID__FUNC_GPIO26>,
				<MT8512_PIN_27_USB_DRV__FUNC_GPIO27>,
				<MT8512_PIN_114_SPI_MISO__FUNC_GPIO114>;
			slew-rate = <0>;
			input-disable;
			bias-disable;
		};
		pins_cmd_dat_1 {
			pinmux = <MT8512_PIN_1_GPIO1__FUNC_GPIO1>;
			slew-rate = <0>;
			bias-disable;
		};
	};

	i2c2_pins: i2c2 {
		pins_bus {
			pinmux = <MT8512_PIN_68_SDA2__FUNC_SDA2_0>,
				 <MT8512_PIN_69_SCL2__FUNC_SCL2_0>;
			input-enable;
			bias-pull-up;
		};
	};

	i2c2_pins_sleep: i2c2_sleep {
		pins_bus {
			pinmux = <MT8512_PIN_68_SDA2__FUNC_GPIO68>,
				 <MT8512_PIN_69_SCL2__FUNC_GPIO69>;
			input-disable;
			bias-disable;
		};
	};

	unused_pins_default: unusedpindefault {
		pins_cmd_dat1 {
			pinmux = <MT8512_PIN_14_GPIO14__FUNC_GPIO14>,
				 <MT8512_PIN_15_GPIO15__FUNC_GPIO15>,
				 <MT8512_PIN_16_GPIO16__FUNC_GPIO16>,
				 <MT8512_PIN_17_GPIO17__FUNC_GPIO17>,
				 <MT8512_PIN_30_CHG_OTG__FUNC_GPIO30>,
				 <MT8512_PIN_112_SPI_CSB__FUNC_GPIO112>,
				 <MT8512_PIN_113_SPI_CLK__FUNC_GPIO113>;
			input-disable;
			bias-disable;
		};
		pins_cmd_dat2 {
			pinmux = <MT8512_PIN_28_EINT_GAUGEING__FUNC_GPIO28>,
				<MT8512_PIN_115_SPI_MOSI__FUNC_GPIO115>;
			input-disable;
			bias-pull-up;
		};
	};

	wpc_en_default: wpc_en_default {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_34_SOC2WAN_RESET__FUNC_GPIO34>;
			input-enable;
			bias-pull-up;
		};
	};

	wpc_en0: wpc_en0 {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_34_SOC2WAN_RESET__FUNC_GPIO34>;
			input-enable;
			bias-pull-up;
		};
	};

	wpc_en1: wpc_en1 {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_34_SOC2WAN_RESET__FUNC_GPIO34>;
			input-enable;
			bias-pull-up;
		};
	};

	sleep_en_default: sleep_en_default {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_35_WAN_FM_RDY__FUNC_GPIO35>;
			input-enable;
			bias-pull-down;
		};
	};

	sleep_en0: sleep_en0 {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_35_WAN_FM_RDY__FUNC_GPIO35>;
			input-enable;
			bias-pull-down;
		};
	};

	sleep_en1: sleep_en1 {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_35_WAN_FM_RDY__FUNC_GPIO35>;
			input-enable;
			bias-pull-down;
		};
	};

	max20342_chg_det_pins_default: max20342_chg_det_pins_default {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_29_CHG_IRQ__FUNC_GPIO29>,
					<MT8512_PIN_31_CHG_CEB__FUNC_GPIO31>;
			input-enable;
			bias-disable;
		};
	};
};
