/dts-v1/;

#include "mt8110-bellatrix.dtsi"

/ {
	model = "MT8110 Bellatrix platform board";
};
&i2c0 {
	fitipmic: fiti@18 {
		compatible = "fiti,pmic";
		reg = <0x18>;
		vgh_ext = <0>;
		vgl_ext = <0>;
		xon_len = <2510>;
		xon_delay = <0>;
		vgh = <28000>;
		vgl = <20000>;
		vcom_setting = <1400>;
		vghnm_setting = <2900>;
		vghnm_ext = <1500>;
		vpos = <15000>;
		vneg = <15000>;
		epd-pmic-en = <&bd71828 1 0>;
		epd-pmic-op = <&pio 9 0>;
		epd-pmic-nm = <&pio 8 0>;
		interrupt-parent = <&pio>;
		interrupts = <10 IRQ_TYPE_LEVEL_HIGH>;
		deb-gpios = <&pio 5 0>;
		debounce = <16>;
		epd-supply = <&bd71828_ldo_dvcc_epd>;
		pinctrl-names = "active", "inactive";
		pinctrl-0 = <&fiti_pins_active>;
		pinctrl-1 = <&fiti_pins_inactive>;
		status = "okay";
	};

	tsc@24 {
		compatible = "cy,cyttsp5_i2c_adapter";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&touch_sensor_pins_default>;
		pinctrl-1 = <&touch_sensor_pins_sleep>;
		reg = <0x24>;

		/* GPIO 1, high-to-low edge triggered */
		interrupts = <1 2>;
		interrupt-parent = <&pio>;
		cy,adapter_id = "cyttsp5_i2c_adapter";
		vcc_ana-supply = <&bd71828_ldo_avcc_touch>;
		vcc_vdd-supply = <&bd71828_ldo_dvcc_touch>;

		cy,core {
			cy,name = "cyttsp5_core";

			cy,irq_gpio = <&pio 1 0>;
			cy,rst_gpio = <&pio 0 0>;
			cy,hid_desc_register = <1>;
			/*CY_CORE_FLAG_RESTORE_PARAMETERS */
			cy,flags = <6>;
			/* CY_CORE_EWG_NONE */
			cy,easy_wakeup_gesture = <0>;

			/* Firmare Board Prefix */
			cy,fw_board_prefix = "malbec";

			cy,mt {
				cy,name = "cyttsp5_mt";

				cy,inp_dev_name = "cyttsp5_mt";
	/* CY_MT_FLAG_FLIP | CY_MT_FLAG_INV_X | CY_MT_FLAG_INV_Y */
				cy,flags = <0x30>;
				cy,abs =
	/* ABS_MT_POSITION_X, CY_ABS_MIN_X, CY_ABS_MAX_X, 0, 0 */
					<0x35 0 880 0 0
	/* ABS_MT_POSITION_Y, CY_ABS_MIN_Y, CY_ABS_MAX_Y, 0, 0 */
					0x36 0 1280 0 0
	/* ABS_MT_PRESSURE, CY_ABS_MIN_P, CY_ABS_MAX_P, 0, 0 */
					0x3a 0 255 0 0
	/* CY_IGNORE_VALUE, CY_ABS_MIN_W, CY_ABS_MAX_W, 0, 0 */
					0xffff 0 255 0 0
	/* ABS_MT_TRACKING_ID, CY_ABS_MIN_T, CY_ABS_MAX_T, 0, 0 */
					0x39 0 15 0 0
	/* ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0 */
					0x30 0 255 0 0
	/* ABS_MT_TOUCH_MINOR, 0, 255, 0, 0 */
					0x31 0 255 0 0
	/* ABS_MT_ORIENTATION, -127, 127, 0, 0 */
					0x34 0xffffff81 127 0 0
	/* ABS_MT_TOOL_TYPE, 0, MT_TOOL_MAX, 0, 0 */
					0x37 0 1 0 0
	/* ABS_MT_DISTANCE, 0, 255, 0, 0 */
					0x3b 0 255 0 0>;

				cy,vkeys_x = <720>;
				cy,vkeys_y = <1280>;

				cy,virtual_keys =
				/* KeyCode CenterX CenterY Width Height */
					/* KEY_BACK */
					<158 1360 90 160 180
					/* KEY_MENU */
					139 1360 270 160 180
					/* KEY_HOMEPAGE */
					172 1360 450 160 180
					/* KEY SEARCH */
					217 1360 630 160 180>;
			};
		};
	};

};

&i2c2 {
	opt3006@44 {
		compatible = "ti,opt3006";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&opt3006_pins_default>;
		pinctrl-1 = <&opt3006_pins_default>;
		reg = <0x44>;
		interrupt-parent = <&pio>;
		interrupts = <100 IRQ_TYPE_EDGE_FALLING>;
	};

	p922x@61 {
		compatible = "IDT,idt_wireless_power";
		reg = <0x61>;
		interrupt-parent = <&pio>;
		interrupts = <34 IRQ_TYPE_EDGE_FALLING 35 IRQ_TYPE_EDGE_RISING>;

		wpc-mivr = <4500000 4500000>;
		wpc-switch-voltage = <4500 5000 5500 8500 9000 9500>;
		bpp-5w-fod = /bits/ 8 <151 47 148 33 149 23 148 21
					148 21 149 21 254 127 0 0>;
		bpp-10w-fod = /bits/ 8 <254 127 254 127 254 127 254 127
					254 127 254 127 254 127 0 0>;

		pinctrl-names = "wpc_en_default", "wpc_en0", "wpc_en1",
					"sleep_en_default", "sleep_en0", "sleep_en1";
		pinctrl-0 = <&wpc_en_default>;
		pinctrl-1 = <&wpc_en0>;
		pinctrl-2 = <&wpc_en1>;
		pinctrl-3 = <&sleep_en_default>;
		pinctrl-4 = <&sleep_en0>;
		pinctrl-5 = <&sleep_en1>;

		p922x-irq = <&pio 34 0>;
		p922x-pg = <&pio 35 0>;

		wpc-hardware-config = <1>;
		status = "okay";
	};

	max20342: max20342@35 {
		compatible = "maxim,max20342";
		interrupt-parent = <&pio>;
		interrupt-controller;
		pinctrl-names = "default";
		pinctrl-0 = <&max20342_chg_det_pins_default>;
		chg_det_int = <&pio 29 GPIO_ACTIVE_LOW>;
		chg_det_ceb = <&pio 31 GPIO_ACTIVE_LOW>;
		reg = <0x35>;
		status = "okay";
	};
};

&hwtcon {
	status = "okay";
	pinctrl-names = "active","inactive";
	pinctrl-0 = <&hwtcon_pins_active>;
	pinctrl-1 = <&hwtcon_pins_inactive>;
	epd{
		panel_dpi_clk = <66600000>;
		panel_width = <1264>;
		panel_height = <1680>;
		panel_area_w = <107>;
		panel_area_h = <142>;
		panel_waveform_type = <4>;
		panel_output_8bit = <0>;
		panel_tcon0 = <6 1686 57 67 0 1 0 0>;
		panel_tcon1 = <6 1686 7 43 0 0 0 0>;
		panel_tcon2 = <5 1688 7 7 4 0 1 7>;
		panel_tcon3 = <1 1690 49 417 0 0 0 0>;
		panel_tcon4 = <0 0 0 0 0 0 0 0>;
		panel_tcon5 = <2 3 256 272 4 1 1 7>;
		panel_dpi = <18 48 7 2 11 4 1>;
		panel_material_type = <4>;
		modify_wf_mode_counter = <1280>;
		status = "okay";
	};
};

&hwtcon_v2 {
	status = "okay";
	pinctrl-names = "active","inactive";
	pinctrl-0 = <&hwtcon_pins_active>;
	pinctrl-1 = <&hwtcon_pins_inactive>;
	epd{
		panel_dpi_clk = <66600000>;
		panel_width = <1264>;
		panel_height = <1680>;
		panel_area_w = <107>;
		panel_area_h = <142>;
		panel_waveform_type = <4>;
		panel_output_8bit = <0>;
		panel_tcon0 = <6 1686 57 67 0 1 0 0>;
		panel_tcon1 = <6 1686 7 43 0 0 0 0>;
		panel_tcon2 = <5 1688 7 7 4 0 1 7>;
		panel_tcon3 = <1 1690 49 417 0 0 0 0>;
		panel_tcon4 = <1 2 7 7 4 1 1 7>;
		panel_tcon5 = <2 3 256 272 4 1 1 7>;
		panel_dpi = <18 48 7 2 11 4 1>;
		panel_material_type = <4>;
		modify_wf_mode_counter = <1280>;
		status = "okay";
	};
};

&pio {
	pinctrl-names = "default";

	opt3006_pins_default: opt3006_default {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_100_DMIC0_DAT0__FUNC_GPIO100>;
			input-enable;
			bias-disable;
		};
	};

	touch_sensor_pins_default: touchsensordefault {
		pins_rst {
			pinmux = <MT8512_PIN_0_GPIO0__FUNC_GPIO0>;  /*TOUCH_RST*/
			bias-pull-down;
		};
		pins_int {
			pinmux = <MT8512_PIN_1_GPIO1__FUNC_GPIO1>;  /*TOUCH_INT*/
			input-enable;
			bias-pull-up;
		};
	};

	touch_sensor_pins_sleep: touchsensorsleep {
		pins_rst {
			pinmux = <MT8512_PIN_0_GPIO0__FUNC_GPIO0>;  /*TOUCH_RST*/
			bias-pull-down;
		};
		pins_int {
			pinmux = <MT8512_PIN_1_GPIO1__FUNC_GPIO1>;  /*TOUCH_INT*/
			input-disable;
			bias-pull-down;
		};
	};

	wpc_en_default: wpc_en_default {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_34_SOC2WAN_RESET__FUNC_GPIO34>;
			input-enable;
			bias-pull-up;
		};
	};

	wpc_en0: wpc_en0 {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_34_SOC2WAN_RESET__FUNC_GPIO34>;
			input-enable;
			bias-pull-up;
		};
	};

	wpc_en1: wpc_en1 {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_34_SOC2WAN_RESET__FUNC_GPIO34>;
			input-enable;
			bias-pull-up;
		};
	};

	sleep_en_default: sleep_en_default {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_35_WAN_FM_RDY__FUNC_GPIO35>;
			input-enable;
			bias-pull-down;
		};
	};

	sleep_en0: sleep_en0 {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_35_WAN_FM_RDY__FUNC_GPIO35>;
			input-enable;
			bias-pull-down;
		};
	};

	sleep_en1: sleep_en1 {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_35_WAN_FM_RDY__FUNC_GPIO35>;
			input-enable;
			bias-pull-down;
		};
	};

	max20342_chg_det_pins_default: max20342_chg_det_pins_default {
		pins_cmd_dat {
			pinmux = <MT8512_PIN_29_CHG_IRQ__FUNC_GPIO29>,
					<MT8512_PIN_31_CHG_CEB__FUNC_GPIO31>;
			input-enable;
			bias-disable;
		};
	};
};
