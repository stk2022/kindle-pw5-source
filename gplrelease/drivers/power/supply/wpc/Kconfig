menuconfig WIRELESS_POWER_CHARGING
	bool "Wireless power charging support"
	help
	  Say Y here to enable wireless power charging support.

if WIRELESS_POWER_CHARGING

config WPC_IDTP922X
	tristate "idtp922X wireless power driver"
	depends on I2C
	default n
	help
		Say Y here to enable support for the idtp922X wireless power.

endif # WIRELESS_POWER_CHARGING
